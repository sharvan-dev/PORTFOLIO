# Copy to .env for local development. Add the same values as server-side
# environment variables in Vercel; never use these in frontend code.
SMTP_HOST=your-smtp-host
SMTP_PORT=465
SMTP_SECURE=true
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-smtp-password
# Optional recipient inbox; defaults to EMAIL_USER.
CONTACT_EMAIL=your-recipient@example.com
